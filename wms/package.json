{
  "name": "squishova-wms",
  "version": "0.1.0",
  "private": true,
  "description": "Squishova WMS — Warehouse Management System mit Shopify-Integration",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
