# --- Datenbank ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/squishova_wms?schema=public"

# --- Auth ---
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET=""

# --- Shopify ---
# Pro Shop werden die Credentials in der Datenbank gehalten (Tabelle Shop).
# Dieses Secret verschluesselt die dort abgelegten Access Tokens.
SHOPIFY_API_SECRET=""

# --- Web Push (VAPID) ---
# Erzeugen mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hallo@squishova.de"

# --- Sonstiges ---
NODE_ENV="development"
LOG_LEVEL="info"
